{
  "meta": {
    "lastTouchedVersion": "2026.3.13",
    "lastTouchedAt": "2026-03-15T14:56:29.234Z"
  },
  "browser": {
    "enabled": true,
    "defaultProfile": "openclaw"
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/qwen/qwen3-coder:free"
      },
      "workspace": "${OPENCLAW_WORKSPACE}",
      "memorySearch": {
        "enabled": false
      }
    },
    "list": [
      {
        "id": "main",
        "default": true
      }
    ]
  },
  "tools": {
    "profile": "minimal",
    "allow": [
      "group:fs",
      "group:runtime",
      "group:web",
      "group:ui",
      "group:sessions",
      "group:automation"
    ],
    "web": {
      "search": {
        "enabled": true,
        "provider": "brave",
        "maxResults": 5,
        "timeoutSeconds": 30,
        "cacheTtlMinutes": 15
      },
      "fetch": {
        "enabled": true,
        "maxChars": 50000,
        "maxCharsCap": 50000,
        "timeoutSeconds": 30,
        "cacheTtlMinutes": 15
      }
    },
    "exec": {
      "host": "gateway",
      "security": "allowlist",
      "ask": "on-miss",
      "notifyOnExit": true
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "cron": {
    "enabled": true
  },
  "channels": {
    "telegram": {
      "capabilities": {
        "inlineButtons": "dm"
      },
      "execApprovals": {
        "enabled": false,
        "approvers": [
          "7428637111"
        ],
        "target": "dm"
      },
      "enabled": true,
      "configWrites": false,
      "dmPolicy": "allowlist",
      "tokenFile": "${OPENCLAW_TELEGRAM_TOKEN_FILE}",
      "allowFrom": [
        "7428637111"
      ],
      "groupPolicy": "disabled",
      "textChunkLimit": 4000,
      "chunkMode": "newline",
      "streaming": "partial",
      "network": {
        "autoSelectFamily": false,
        "dnsResultOrder": "ipv4first"
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "skills": {
    "load": {
      "watch": true,
      "watchDebounceMs": 250
    }
  }
}
