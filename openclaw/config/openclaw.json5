{
  "meta": {
    "lastTouchedVersion": "2026.3.13",
    "lastTouchedAt": "2026-03-15T16:09:13.228Z"
  },
  "update": {
    "auto": {
      "enabled": true
    }
  },
  "browser": {
    "enabled": true,
    "defaultProfile": "openclaw"
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "huggingface/Qwen/Qwen3-8B"
      },
      "workspace": "${OPENCLAW_WORKSPACE}",
      "memorySearch": {
        "enabled": false
      },
      "subagents": {
        "maxConcurrent": 4,
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 4,
        "archiveAfterMinutes": 120,
        "model": "huggingface/Qwen/Qwen3-8B",
        "runTimeoutSeconds": 600
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "tools": {
          "alsoAllow": [
            "read",
            "write",
            "edit",
            "apply_patch",
            "exec",
            "process",
            "web_search",
            "web_fetch",
            "memory_search",
            "memory_get",
            "sessions_list",
            "sessions_history",
            "sessions_send",
            "sessions_spawn",
            "sessions_yield",
            "subagents",
            "browser",
            "canvas",
            "message",
            "cron",
            "gateway",
            "nodes",
            "agents_list",
            "image",
            "tts"
          ]
        }
      }
    ]
  },
  "tools": {
    "profile": "minimal",
    "allow": [
      "group:fs",
      "group:runtime",
      "group:web",
      "group:ui",
      "group:sessions",
      "group:automation"
    ],
    "web": {
      "search": {
        "enabled": true,
        "provider": "brave",
        "maxResults": 5,
        "timeoutSeconds": 30,
        "cacheTtlMinutes": 15
      },
      "fetch": {
        "enabled": true,
        "maxChars": 50000,
        "maxCharsCap": 50000,
        "timeoutSeconds": 30,
        "cacheTtlMinutes": 15
      }
    },
    "exec": {
      "host": "gateway",
      "security": "allowlist",
      "ask": "on-miss",
      "notifyOnExit": true
    }
  },
  "messages": {
    "tts": {
      "auto": "tagged",
      "mode": "final",
      "provider": "elevenlabs",
      "modelOverrides": {
        "enabled": true
      },
      "elevenlabs": {
        "modelId": "eleven_multilingual_v2",
        "voiceSettings": {
          "stability": 0.45,
          "similarityBoost": 0.8,
          "style": 0.1,
          "useSpeakerBoost": true,
          "speed": 1
        }
      },
      "maxTextLength": 2500,
      "timeoutMs": 30000
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "cron": {
    "enabled": true
  },
  "channels": {
    "telegram": {
      "capabilities": {
        "inlineButtons": "dm"
      },
      "execApprovals": {
        "enabled": true,
        "approvers": [
          7428637111
        ],
        "target": "dm"
      },
      "enabled": true,
      "configWrites": false,
      "dmPolicy": "allowlist",
      "tokenFile": "${OPENCLAW_TELEGRAM_TOKEN_FILE}",
      "allowFrom": [
        7428637111
      ],
      "groupPolicy": "disabled",
      "textChunkLimit": 4000,
      "chunkMode": "newline",
      "streaming": "partial",
      "network": {
        "autoSelectFamily": false,
        "dnsResultOrder": "ipv4first"
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "skills": {
    "load": {
      "watch": true,
      "watchDebounceMs": 250
    }
  }
}
