{
  "expo": {
    "name": "RipoAI",
    "slug": "ripoai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ripoai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "io.github.riporipoteam.ripoai",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "WKAppBoundDomains": [
          "riporipoteam-ctrl.github.io"
        ]
      }
    },
    "android": {
      "package": "io.github.riporipoteam.ripoai"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
